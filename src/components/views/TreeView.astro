---
import FamilyTree from "../FamilyTree.tsx";
import ViewModeToggle from "../ViewModeToggle.astro";
import { getPeople, type PeopleView } from "../../lib/people";
import { bloodlineIds } from "../../lib/family-membership";
import { useTranslations, localize, type Locale } from "../../i18n/ui";

interface Props {
  lang: Locale;
  view?: PeopleView;
}
const { lang, view = "core" } = Astro.props;
const t = useTranslations(lang);

const people = await getPeople(view);
// Same definition and population as the home and stats pages, in both views.
const familyCount = bloodlineIds(await getPeople("extended")).size;
const dataUrl = localize(view === "extended" ? "/extended/tree-data.json" : "/tree-data.json", lang);
const peoplePath = localize(view === "extended" ? "/extended/people" : "/people", lang);

const labels = {
  hint: t("tree.hint"),
  zoomIn: t("tree.zoomIn"),
  zoomOut: t("tree.zoomOut"),
  reset: t("tree.reset"),
  fullscreen: t("tree.fullscreen"),
  exitFullscreen: t("tree.exitFullscreen"),
  expandAll: t("tree.expandAll"),
  collapseAll: t("tree.collapseAll"),
  living: t("tree.living"),
  deceased: t("tree.deceased"),
  born: t("person.born"),
  died: t("person.died"),
  birthplace: t("person.birthplace"),
  female: t("tree.female"),
  male: t("tree.male"),
  showMore: t("tree.showMore"),
  search: t("tree.search"),
  searchPlaceholder: t("tree.searchPlaceholder"),
  searchEmpty: t("tree.searchEmpty"),
  center: t("tree.center"),
  loading: t("tree.loading"),
  branchMode: t("tree.branchMode"),
  showAll: t("tree.showAll"),
  otherSurname: t("tree.otherSurname"),
  loadError: t("tree.loadError"),
  treeRegion: t("tree.region"),
  keyboardHelp: t("tree.keyboardHelp"),
};
---

<section
  class="tree-topper mx-auto flex max-w-[1600px] flex-col gap-4 px-5 pt-5 pb-3 sm:flex-row sm:pt-6 sm:flex-wrap sm:items-end sm:justify-between"
>
  <div>
    <p class="eyebrow">{t("home.eyebrow", { n: familyCount })}</p>
    <h1 class="mt-2 text-3xl font-semibold text-ink sm:text-4xl">
      {t("tree.title")}
    </h1>
    <p class="tree-subtitle mt-2 max-w-2xl text-muted">{t("tree.subtitle")}</p>
  </div>
  <a
    href={localize(view === "extended" ? "/extended/poster.svg" : "/poster.svg", lang)}
    download
    class="button-secondary w-fit text-sm"
  >
    ↓ {t("tree.poster")}
  </a>
  <ViewModeToggle lang={lang} current={view} section="tree" />
</section>

<section class="mx-auto max-w-[1600px] px-5 pb-12">
  <noscript>
    <p class="surface-panel mb-4 p-4 text-muted">
      <a href={peoplePath} class="text-accent underline">{t("nav.directory")}</a>
    </p>
  </noscript>
  <FamilyTree
    client:load
    dataUrl={dataUrl}
    labels={labels}
    basePath={peoplePath}
  />
</section>
